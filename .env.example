# ── Base de datos ─────────────────────────────────────────────────────────────
DB_USER=postgres
DB_PASSWORD=CAMBIA_ESTO
DB_NAME=nomina_konecta

# ── Backend ───────────────────────────────────────────────────────────────────
JWT_SECRET=CAMBIA_ESTO_MIN_32_CHARS
JWT_EXPIRES_IN=24h

# URL pública del frontend (usada en CORS y redirect de OAuth)
FRONTEND_URL=http://localhost:3000

# ── Google OAuth (opcional) ───────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3001/api/auth/google/callback

# ── Email (opcional) ──────────────────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
