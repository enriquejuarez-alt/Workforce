generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Rol {
  ADMINISTRADOR
  USUARIO
  WORKFORCE
  CAPACITADOR
  LIDER
}

enum EstadoNomina {
  BORRADOR
  ACTIVA
  CERRADA
  ARCHIVADA
}

model Usuario {
  id                  Int      @id @default(autoincrement())
  nombre              String
  email               String   @unique
  password_hash       String
  rol                 Rol      @default(USUARIO)
  servicio_id         Int?
  activo              Boolean  @default(true)
  fecha_creacion      DateTime @default(now())
  fecha_actualizacion DateTime @updatedAt
  ultimo_acceso       DateTime?

  servicio             Servicio? @relation(fields: [servicio_id], references: [id])

  permisos             UsuarioServicioPermiso[]
  importaciones        ImportacionNomina[]
  auditorias           Auditoria[]
  licencias_registradas        Licencia[]
  licencia_importaciones       LicenciaImportacion[]
  cambios_registrados          CambioServicioTemporal[]
  bajas_creadas                HistoricoBaja[]          @relation("BajaCreador")
  remociones_creadas           Remocion[]               @relation("RemocionCreador")
  cambios_contrato_creados     CambioContrato[]
  cambios_horario_creados      CambioHorario[]
  capacitaciones_creadas       Capacitacion[]
  capacitaciones_a_cargo       Capacitacion[]           @relation("CapacitacionCapacitador")
  vacacion_importaciones       VacacionImportacion[]
  programaciones_creadas       ProgramacionMensual[]
  reductor_importaciones       ReductorImportacion[]
  franco_importaciones         FrancoImportacion[]
  cp_importaciones             CpImportacion[]
  planificaciones_guardadas    PlanificacionGuardada[]
  agente_servicio_historial_creados  AgenteServicioHistorial[]
  agente_modalidad_historial_creados AgenteModalidadHistorial[]
  agente_superior_historial_creados  AgenteSuperiorHistorial[]
  historial_servicio_importaciones   HistorialServicioImportacion[]

  @@map("usuarios")
}

model Servicio {
  id                  Int      @id @default(autoincrement())
  nombre              String   @unique
  descripcion         String?
  color               String   @default("#6366f1")
  activo              Boolean  @default(true)
  plani_config        Json?
  fecha_creacion      DateTime @default(now())
  fecha_actualizacion DateTime @updatedAt

  permisos                UsuarioServicioPermiso[]
  lideres                 Usuario[]
  agentes                 Agente[]
  nominas                 NominaMensual[]
  auditorias              Auditoria[]
  cambios_como_temporal   CambioServicioTemporal[] @relation("ServicioTemporal")
  snapshots               AgenteNominaMensual[]
  bajas                   HistoricoBaja[]
  remociones              Remocion[]               @relation("RemocionServicio")
  remociones_destino      Remocion[]               @relation("RemocionDestino")
  cambios_contrato        CambioContrato[]
  cambios_horario         CambioHorario[]
  capacitaciones          Capacitacion[]
  programaciones          ProgramacionMensual[]
  agente_servicio_historial AgenteServicioHistorial[]
  agente_superior_historial AgenteSuperiorHistorial[]

  @@map("servicios")
}

model UsuarioServicioPermiso {
  id                                Int      @id @default(autoincrement())
  usuario_id                        Int
  servicio_id                       Int
  puede_ver                         Boolean  @default(false)
  puede_usar_filtros                Boolean  @default(false)
  puede_editar_nomina_mes_corriente  Boolean  @default(false)
  puede_ver_nominas_historicas       Boolean  @default(false)
  puede_editar_nominas_historicas    Boolean  @default(false)
  puede_cargar_excel                 Boolean  @default(false)
  puede_exportar                     Boolean  @default(false)
  puede_exportar_nominas_historicas  Boolean  @default(false)
  puede_registrar_licencia           Boolean  @default(false)
  puede_registrar_cambio_servicio    Boolean  @default(false)
  puede_crear_agente                 Boolean  @default(false)
  puede_desactivar_agente            Boolean  @default(false)
  puede_comparar_nominas_mensuales   Boolean  @default(false)
  puede_ver_historial_agente         Boolean  @default(false)
  puede_editar_historial_agente      Boolean  @default(false)
  puede_ver_motivos_sensibles        Boolean  @default(false)
  puede_registrar_remocion           Boolean  @default(false)
  puede_corregir_historial           Boolean  @default(false)
  campos_editables                   String[] @default([])
  segmentos_permitidos               String[] @default([])
  fecha_creacion                     DateTime @default(now())
  fecha_actualizacion                DateTime @updatedAt
  actualizado_por                    Int?

  usuario  Usuario  @relation(fields: [usuario_id], references: [id])
  servicio Servicio @relation(fields: [servicio_id], references: [id])

  @@unique([usuario_id, servicio_id])
  @@map("usuario_servicio_permisos")
}

model Agente {
  id                  Int      @id @default(autoincrement())
  dni                 String   @unique
  usuario             String   @unique
  nombre              String
  superior            String?
  segmento            String?
  horarios            String?
  estado              String?
  contrato            String?
  sitio               String?
  modalidad           String?
  jefe                String?
  servicio_id         Int?
  activo              Boolean  @default(true)
  presente_ultima_carga Boolean @default(true)
  observaciones       String?
  fecha_nacimiento    DateTime? @db.Date
  fecha_creacion      DateTime @default(now())
  fecha_actualizacion DateTime @updatedAt

  servicio           Servicio?               @relation(fields: [servicio_id], references: [id])
  licencias          Licencia[]
  cambios_temporales CambioServicioTemporal[]
  cambios_contrato   CambioContrato[]
  cambios_horario    CambioHorario[]
  capacitaciones     Capacitacion[]
  snapshots          AgenteNominaMensual[]
  bajas              HistoricoBaja[]
  remociones         Remocion[]
  vacaciones         Vacacion[]
  servicio_historial  AgenteServicioHistorial[]
  modalidad_historial AgenteModalidadHistorial[]
  superior_historial  AgenteSuperiorHistorial[]
  auditorias          Auditoria[]

  @@map("agentes")
}

model AgenteServicioHistorial {
  id             Int       @id @default(autoincrement())
  agente_id      Int
  servicio_id    Int?
  modalidad      String?
  superior       String?
  jefe           String?
  segmento       String?
  sitio          String?
  contrato       String?
  horarios       String?
  fecha_desde    DateTime  @db.Date
  fecha_hasta    DateTime? @db.Date
  motivo         String?
  observaciones  String?
  creado_por     Int
  fecha_creacion DateTime  @default(now())

  agente   Agente    @relation(fields: [agente_id], references: [id])
  servicio Servicio? @relation(fields: [servicio_id], references: [id])
  creador  Usuario   @relation(fields: [creado_por], references: [id])

  @@index([agente_id])
  @@index([servicio_id])
  @@map("agente_servicio_historial")
}

model AgenteModalidadHistorial {
  id                 Int      @id @default(autoincrement())
  agente_id          Int
  modalidad_anterior String?
  modalidad_nueva    String
  fecha_efectiva     DateTime @db.Date
  motivo             String?
  observaciones      String?
  creado_por         Int
  fecha_creacion     DateTime @default(now())

  agente  Agente  @relation(fields: [agente_id], references: [id])
  creador Usuario @relation(fields: [creado_por], references: [id])

  @@index([agente_id])
  @@map("agente_modalidad_historial")
}

model AgenteSuperiorHistorial {
  id                Int      @id @default(autoincrement())
  agente_id         Int
  servicio_id       Int?
  superior_anterior String?
  superior_nuevo    String?
  fecha_efectiva    DateTime @db.Date
  motivo            String?
  observaciones     String?
  creado_por        Int
  fecha_creacion    DateTime @default(now())

  agente   Agente    @relation(fields: [agente_id], references: [id])
  servicio Servicio? @relation(fields: [servicio_id], references: [id])
  creador  Usuario   @relation(fields: [creado_por], references: [id])

  @@index([agente_id])
  @@map("agente_superior_historial")
}

model HistorialServicioImportacion {
  id                            Int      @id @default(autoincrement())
  archivo_nombre                String
  fecha_desde_archivo           DateTime @db.Date
  fecha_hasta_archivo           DateTime @db.Date
  importado_por                 Int
  fecha_importacion             DateTime @default(now())
  agentes_en_archivo            Int      @default(0)
  agentes_creados               Int      @default(0)
  agentes_no_encontrados        Int      @default(0)
  transiciones_servicio_creadas  Int     @default(0)
  transiciones_superior_creadas  Int     @default(0)
  areas_sin_mapeo               String[] @default([])

  importador Usuario @relation(fields: [importado_por], references: [id])

  @@map("historial_servicio_importaciones")
}

model NominaMensual {
  id                  Int          @id @default(autoincrement())
  servicio_id         Int
  mes                 Int
  anio                Int
  tipo                String       @default("OPERACION")
  estado              EstadoNomina @default(BORRADOR)
  archivo_nombre      String?
  cargado_por         Int?
  fecha_carga         DateTime?
  total_agentes       Int          @default(0)
  agentes_creados     Int          @default(0)
  agentes_actualizados Int         @default(0)
  agentes_no_presentes Int         @default(0)
  errores             Int          @default(0)
  observaciones       String?
  fecha_creacion      DateTime     @default(now())
  fecha_actualizacion DateTime     @updatedAt

  servicio       Servicio              @relation(fields: [servicio_id], references: [id])
  snapshots      AgenteNominaMensual[]
  importaciones  ImportacionNomina[]
  auditorias     Auditoria[]
  programaciones ProgramacionMensual[]

  @@unique([servicio_id, mes, anio, tipo])
  @@map("nominas_mensuales")
}

model AgenteNominaMensual {
  id                Int      @id @default(autoincrement())
  nomina_mensual_id Int
  agente_id         Int
  dni               String
  usuario           String
  nombre            String
  superior          String?
  segmento          String?
  horarios          String?
  estado            String?
  contrato          String?
  sitio             String?
  modalidad         String?
  jefe              String?
  servicio_id       Int?
  horas_por_dia     Float?
  dias_trabajados_semana Float?
  presente_en_nomina Boolean @default(true)
  observaciones     String?
  fecha_actualizacion DateTime @updatedAt

  nomina_mensual NominaMensual @relation(fields: [nomina_mensual_id], references: [id])
  agente         Agente        @relation(fields: [agente_id], references: [id])
  servicio       Servicio?     @relation(fields: [servicio_id], references: [id])

  @@unique([nomina_mensual_id, agente_id])
  @@map("agente_nomina_mensual")
}

model LicenciaImportacion {
  id                     Int      @id @default(autoincrement())
  archivo_nombre         String
  importado_por          Int
  fecha_importacion      DateTime @default(now())
  total_dias             Int      @default(0)
  total_periodos         Int      @default(0)
  agentes_encontrados    Int      @default(0)
  agentes_no_encontrados Int      @default(0)

  importador Usuario    @relation(fields: [importado_por], references: [id])
  licencias  Licencia[]

  @@map("licencia_importaciones")
}

model Licencia {
  id               Int      @id @default(autoincrement())
  agente_id        Int
  fecha_desde      DateTime
  fecha_hasta      DateTime
  motivo           String?
  observacion      String?
  creado_por       Int
  importacion_id   Int?
  fecha_creacion   DateTime @default(now())

  agente      Agente               @relation(fields: [agente_id], references: [id])
  creador     Usuario              @relation(fields: [creado_por], references: [id])
  importacion LicenciaImportacion? @relation(fields: [importacion_id], references: [id])

  @@index([agente_id])
  @@index([importacion_id])
  @@index([fecha_desde, fecha_hasta])
  @@map("licencias")
}

model CambioServicioTemporal {
  id                   Int      @id @default(autoincrement())
  agente_id            Int
  servicio_original_id Int?
  servicio_temporal_id Int?
  fecha_desde          DateTime
  fecha_hasta          DateTime
  motivo               String?
  observacion          String?
  creado_por           Int
  fecha_creacion       DateTime @default(now())

  agente            Agente    @relation(fields: [agente_id], references: [id])
  servicio_temporal Servicio? @relation("ServicioTemporal", fields: [servicio_temporal_id], references: [id])
  creador           Usuario   @relation(fields: [creado_por], references: [id])

  @@map("cambios_servicio_temporal")
}

model ImportacionNomina {
  id                  Int      @id @default(autoincrement())
  nomina_mensual_id   Int
  archivo_nombre      String
  usuario_id          Int
  fecha_importacion   DateTime @default(now())
  total_filas         Int      @default(0)
  agentes_creados     Int      @default(0)
  agentes_actualizados Int     @default(0)
  agentes_no_presentes Int     @default(0)
  errores             Int      @default(0)
  estado              String   @default("COMPLETADO")
  detalle_errores     Json?

  nomina_mensual NominaMensual @relation(fields: [nomina_mensual_id], references: [id])
  usuario        Usuario       @relation(fields: [usuario_id], references: [id])

  @@map("importaciones_nomina")
}

model HistoricoBaja {
  id               Int      @id @default(autoincrement())
  fecha            DateTime @db.Date
  dni              String
  nombre           String
  usuario_sistema  String?
  superior         String?
  jefatura         String?
  servicio_id      Int?
  servicio_nombre  String?
  tipo             String?
  segmento         String?
  horarios         String?
  estado           String?
  contrato         String?
  sitio            String?
  modalidad        String?
  jefe             String?
  observacion      String?
  agente_id        Int?
  creado_por       Int
  fecha_creacion   DateTime @default(now())
  fecha_actualizacion DateTime @updatedAt

  servicio Servicio? @relation(fields: [servicio_id], references: [id])
  agente   Agente?   @relation(fields: [agente_id], references: [id])
  creador  Usuario   @relation("BajaCreador", fields: [creado_por], references: [id])

  @@index([dni])
  @@index([servicio_id])
  @@index([servicio_id, fecha])
  @@map("historico_bajas")
}

model Remocion {
  id                  Int      @id @default(autoincrement())
  fecha               DateTime @db.Date
  dni                 String
  nombre              String
  usuario_sistema     String?
  superior            String?
  jefatura            String?
  servicio_id         Int?
  servicio_nombre     String?
  motivo              String?
  segmento            String?
  horarios            String?
  estado              String?
  contrato            String?
  sitio               String?
  modalidad           String?
  jefe                String?
  observacion         String?
  agente_id           Int?
  creado_por          Int
  fecha_creacion      DateTime @default(now())
  fecha_actualizacion DateTime @updatedAt

  // Workflow de remocion (Historial de Agentes)
  tipo                        String?
  estado_remocion             String?   @default("PENDIENTE_REASIGNACION")
  servicio_destino_id         Int?
  fecha_incorporacion_destino DateTime? @db.Date

  servicio         Servicio? @relation("RemocionServicio", fields: [servicio_id], references: [id])
  servicio_destino Servicio? @relation("RemocionDestino", fields: [servicio_destino_id], references: [id])
  agente           Agente?   @relation(fields: [agente_id], references: [id])
  creador          Usuario   @relation("RemocionCreador", fields: [creado_por], references: [id])

  @@index([dni])
  @@index([servicio_id])
  @@index([servicio_id, fecha])
  @@map("remociones")
}

model CambioContrato {
  id                  Int       @id @default(autoincrement())
  agente_id           Int
  agente_dni          String
  agente_nombre       String
  servicio_id         Int?
  tipo                String    // 'TEMPORAL' | 'DEFINITIVO'
  contrato_anterior   String?
  contrato_nuevo      String    // '30' | '35' | '36'
  fecha_desde         DateTime  @db.Date
  fecha_hasta         DateTime? @db.Date
  motivo              String?
  observacion         String?
  creado_por          Int
  fecha_creacion      DateTime  @default(now())
  fecha_actualizacion DateTime  @updatedAt

  agente   Agente    @relation(fields: [agente_id], references: [id])
  servicio Servicio? @relation(fields: [servicio_id], references: [id])
  creador  Usuario   @relation(fields: [creado_por], references: [id])

  @@index([agente_id])
  @@index([servicio_id])
  @@map("cambios_contrato")
}

model CambioHorario {
  id                  Int       @id @default(autoincrement())
  agente_id           Int
  agente_dni          String
  agente_nombre       String
  servicio_id         Int?
  tipo                String    // 'TEMPORAL' | 'DEFINITIVO'
  horario_anterior    String?
  horario_nuevo       String
  fecha_desde         DateTime  @db.Date
  fecha_hasta         DateTime? @db.Date
  motivo              String?
  observacion         String?
  creado_por          Int
  fecha_creacion      DateTime  @default(now())
  fecha_actualizacion DateTime  @updatedAt

  agente   Agente    @relation(fields: [agente_id], references: [id])
  servicio Servicio? @relation(fields: [servicio_id], references: [id])
  creador  Usuario   @relation(fields: [creado_por], references: [id])

  @@index([agente_id])
  @@index([servicio_id])
  @@map("cambios_horario")
}

model Capacitacion {
  id                  Int      @id @default(autoincrement())
  agente_id           Int?
  agente_dni          String?
  agente_nombre       String
  usuario_sistema     String?
  superior            String?
  servicio_id         Int?
  servicio_nombre     String?
  segmento            String?
  horarios            String?
  estado              String?
  contrato            String?
  sitio               String?
  modalidad           String?
  jefe                String?
  observacion         String?
  tipo_formacion      String?
  fecha_inicio        DateTime @db.Date
  fecha_fin           DateTime @db.Date
  dado_de_alta        Boolean  @default(false)
  pendiente_alta      Boolean  @default(false)
  fecha_alta          DateTime?
  creado_por          Int
  fecha_creacion      DateTime @default(now())
  fecha_actualizacion DateTime @updatedAt

  // Resultado (Historial de Agentes)
  resultado        String?
  calificacion     String?
  capacitador_id   Int?
  certificado_url  String?

  agente      Agente?   @relation(fields: [agente_id], references: [id])
  servicio    Servicio? @relation(fields: [servicio_id], references: [id])
  creador     Usuario   @relation(fields: [creado_por], references: [id])
  capacitador Usuario?  @relation("CapacitacionCapacitador", fields: [capacitador_id], references: [id])

  @@index([agente_id])
  @@index([servicio_id])
  @@map("capacitaciones")
}

model VacacionImportacion {
  id                     Int      @id @default(autoincrement())
  archivo_nombre         String
  importado_por          Int
  fecha_importacion      DateTime @default(now())
  total_dias             Int      @default(0)
  total_periodos         Int      @default(0)
  agentes_encontrados    Int      @default(0)
  agentes_no_encontrados Int      @default(0)

  importador  Usuario    @relation(fields: [importado_por], references: [id])
  vacaciones  Vacacion[]

  @@map("vacacion_importaciones")
}

model Vacacion {
  id             Int      @id @default(autoincrement())
  agente_id      Int?
  agente_dni     String
  agente_nombre  String
  fecha_desde    DateTime @db.Date
  fecha_hasta    DateTime @db.Date
  site           String?
  servicio_wf    String?
  importacion_id Int
  fecha_creacion DateTime @default(now())

  agente      Agente?             @relation(fields: [agente_id], references: [id])
  importacion VacacionImportacion @relation(fields: [importacion_id], references: [id])

  @@index([agente_dni])
  @@index([importacion_id])
  @@map("vacaciones")
}

model ProgramacionMensual {
  id                  Int      @id @default(autoincrement())
  servicio_id         Int
  mes                 Int
  anio                Int
  semana              Int      @default(0)  // 0 = mes completo, 1-4 = semana específica
  nomina_id           Int?     // nómina base para la simulación
  estado              String   @default("BORRADOR")
  creado_por          Int
  fecha_creacion      DateTime @default(now())
  fecha_actualizacion DateTime @updatedAt

  servicio   Servicio          @relation(fields: [servicio_id], references: [id])
  nomina     NominaMensual?    @relation(fields: [nomina_id], references: [id])
  creador    Usuario           @relation(fields: [creado_por], references: [id])
  requeridos RequeridoHorario[]
  factor     FactorReduccion?

  @@unique([servicio_id, mes, anio, semana])
  @@map("programaciones_mensuales")
}

model RequeridoHorario {
  id              Int      @id @default(autoincrement())
  programacion_id Int
  fecha           DateTime @db.Date
  intervalo       String   // "08:00"
  requeridos      Int
  es_feriado      Boolean  @default(false)

  programacion ProgramacionMensual @relation(fields: [programacion_id], references: [id], onDelete: Cascade)

  @@unique([programacion_id, fecha, intervalo])
  @@map("requeridos_horario")
}

model FactorReduccion {
  id              Int   @id @default(autoincrement())
  programacion_id Int   @unique
  deslogueo       Float @default(0)
  ausentismo      Float @default(0)
  rotacion        Float @default(0)

  programacion ProgramacionMensual @relation(fields: [programacion_id], references: [id], onDelete: Cascade)

  @@map("factores_reduccion")
}

model ReductorImportacion {
  id                  Int      @id @default(autoincrement())
  mes                 Int
  anio                Int
  nombre              String?
  archivo_nombre      String?
  importado_por       Int
  fecha_importacion   DateTime @default(now())
  fecha_actualizacion DateTime @updatedAt

  importador Usuario            @relation(fields: [importado_por], references: [id])
  servicios  ReductorServicio[]

  @@index([mes, anio])
  @@map("reductor_importaciones")
}

model ReductorServicio {
  id             Int    @id @default(autoincrement())
  importacion_id Int
  servicio       String
  servicio_norm  String
  deslogueo      Float  @default(0)
  ausentismo     Float  @default(0)
  rotacion       Float  @default(0)

  importacion ReductorImportacion @relation(fields: [importacion_id], references: [id])

  @@index([importacion_id])
  @@map("reductor_servicios")
}

model FrancoImportacion {
  id                  Int      @id @default(autoincrement())
  mes                 Int
  anio                Int
  nombre              String?
  archivo_nombre      String?
  importado_por       Int
  fecha_importacion   DateTime @default(now())
  fecha_actualizacion DateTime @updatedAt

  importador Usuario          @relation(fields: [importado_por], references: [id])
  servicios  FrancoServicio[]

  @@index([mes, anio])
  @@map("franco_importaciones")
}

model FrancoServicio {
  id               Int    @id @default(autoincrement())
  importacion_id   Int
  servicio         String
  servicio_norm    String
  dotacion         Float  @default(0)
  ponderado_horas  Float  @default(0)
  ponderado_dias   Float  @default(0)
  franco_lunes     Float  @default(0)
  franco_martes    Float  @default(0)
  franco_miercoles Float  @default(0)
  franco_jueves    Float  @default(0)
  franco_viernes   Float  @default(0)
  franco_sabado    Float  @default(0)
  franco_domingo   Float  @default(0)

  importacion FrancoImportacion @relation(fields: [importacion_id], references: [id])

  @@index([importacion_id])
  @@map("franco_servicios")
}

model CpImportacion {
  id                  Int      @id @default(autoincrement())
  mes                 Int
  anio                Int
  formato             String   // 'soporte' | 'ventas' | 'smb' | 'onboarding' | 'ppay'
  nombre              String?
  archivo_nombre      String?
  importado_por       Int
  fecha_importacion   DateTime @default(now())
  fecha_actualizacion DateTime @updatedAt

  importador Usuario      @relation(fields: [importado_por], references: [id])
  servicios  CpServicio[]

  @@index([mes, anio])
  @@map("cp_importaciones")
}

model CpServicio {
  id             Int    @id @default(autoincrement())
  importacion_id Int
  servicio       String
  servicio_norm  String
  dias_del_mes   Int    @default(0)
  total_mes      Float  @default(0)
  // MatrizServicio completa serializada (dias/matriz/hcMatrix/totalDiario),
  // ver lib/domain/serializacion.ts para el formato exacto.
  matriz         Json

  importacion CpImportacion @relation(fields: [importacion_id], references: [id])

  @@index([importacion_id])
  @@map("cp_servicios")
}

model PlanificacionGuardada {
  id                  Int      @id @default(autoincrement())
  servicio_key        String
  servicio_nombre     String
  mes                 Int
  anio                Int
  nombre              String?
  dias_del_mes        Int
  tope_facturacion    Int      @default(103)
  modo_reductor       String   @default("multiplicativo")

  cumplimiento_total  Float
  personas_activas    Int
  hs_requeridas       Float

  resultado           Json
  matrices            Json
  agentes             Json
  reductores          Json
  alertas             Json
  francos_servicio    Json?

  guardado_por        Int
  guardador           Usuario  @relation(fields: [guardado_por], references: [id])
  fecha_guardado      DateTime @default(now())
  fecha_actualizacion DateTime @updatedAt

  @@index([mes, anio])
  @@map("planificaciones_guardadas")
}

model Auditoria {
  id                Int      @id @default(autoincrement())
  usuario_id        Int?
  accion            String
  entidad           String?
  entidad_id        String?
  servicio_id       Int?
  nomina_mensual_id Int?
  campo_modificado  String?
  valor_anterior    String?
  valor_nuevo       String?
  fecha_hora        DateTime @default(now())
  ip                String?
  user_agent        String?
  agente_id         Int?

  usuario        Usuario?       @relation(fields: [usuario_id], references: [id])
  servicio       Servicio?      @relation(fields: [servicio_id], references: [id])
  nomina_mensual NominaMensual? @relation(fields: [nomina_mensual_id], references: [id])
  agente         Agente?        @relation(fields: [agente_id], references: [id])

  @@index([agente_id])
  @@map("auditorias")
}

model ConfiguracionRolPath {
  id    Int    @id @default(autoincrement())
  rol   String @unique
  paths Json   // string[]

  @@map("configuracion_rol_paths")
}

model UsuarioSeccion {
  id         Int @id @default(autoincrement())
  usuario_id Int @unique
  paths      Json // string[] — secciones permitidas para este usuario específico

  @@map("usuario_secciones")
}
